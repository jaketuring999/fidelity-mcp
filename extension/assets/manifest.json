{
  "manifest_version": 3,
  "name": "Fidelity MCP",
  "version": "0.2.0",
  "description": "Connect your Fidelity tab to your local MCP server to read accounts, balances and positions.",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": ["nativeMessaging", "scripting", "storage", "alarms"],
  "host_permissions": ["https://digital.fidelity.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Fidelity MCP",
    "default_popup": "popup.html"
  }
}
