{
  "name": "fidelity-mcp",
  "version": "0.2.0",
  "private": true,
  "description": "Local Fidelity MCP server with a companion Chrome extension",
  "type": "module",
  "bin": {
    "fidelity-mcp": "dist/index.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/extension/manifest.json",
    "docs/architecture.md",
    "docs/setup.md",
    "docs/tools.md",
    "docs/development.md",
    "docs/security.md",
    "docs/fidelity/README.md",
    "docs/fidelity/shared-context.md",
    "docs/fidelity/openapi.json",
    "docs/fidelity/examples.json",
    "docs/fidelity/endpoint-catalog.json"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && node dist/index.js",
    "dev": "tsx src/index.ts",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p extension/tsconfig.json",
    "test": "npm run build && tsx --test tests/e2e/*.test.ts",
    "setup": "npm run build && node dist/index.js setup",
    "prepack": "npm run check && npm run build",
    "check:live": "tsx scripts/check-live.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start:debugging": "npm start -- --bridge chrome-debugging",
    "start:extension": "npm start -- --bridge extension",
    "dev:debugging": "npm run dev -- --bridge chrome-debugging"
  },
  "dependencies": {
    "@better-auth/cimd": "1.7.7",
    "@better-auth/mcp": "1.7.7",
    "@better-auth/oauth-provider": "1.7.7",
    "@hono/node-server": "1.19.17",
    "@modelcontextprotocol/server": "2.3.1",
    "@prefecthq/fastmcp-ts": "1.7.3",
    "better-auth": "1.7.7",
    "jose": "6.2.3",
    "playwright": "^1.64.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@types/chrome": "^0.3.4",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "8.71.1"
  }
}
